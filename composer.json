{
    "name": "kolyayurev/adminpanel",
    "description": "Admin panel",
    "keywords": [
        "kolyayurev",
        "laravel",
        "adminpanel"
    ],
    "homepage": "https://github.com/kolyayurev/adminpanel",
    "license": "MIT",
    "authors": [
        {
            "name": "Nikolay Yurev",
            "email": "kolyayurew@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "gregwar/image": "^2.1",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "intervention/image": "^2.7",
        "laravel/ui": "^4.6",
        "rap2hpoutre/laravel-log-viewer": "^3.1",
        "twbs/bootstrap-icons": "^1.10",
        "yajra/laravel-datatables-oracle": "^13.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "KY\\AdminPanel\\": "src",
            "KY\\AdminPanel\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KY\\AdminPanel\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        },
        "laravel": {
            "providers": [
                "KY\\AdminPanel\\AdminPanelServiceProvider"
            ],
            "aliases": {
                "AdminPanel": "KY\\AdminPanel\\Facades\\AdminPanel"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
